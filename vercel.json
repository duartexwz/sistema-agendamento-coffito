{
  "name": "sistema-agendamento-coffito",
  "version": 2,
  "builds": [
    {
      "src": "front/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/proxy.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js?path=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/front/dist/$1"
    }
  ],
  "env": {
    "BACKEND_URL": "https://sistema-agendamento-coffito.vercel.app"
  },
  "rewrites": [],
  "cleanUrls": true,
  "trailingSlash": false
}