{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back": {
      "root": "back",
      "framework": "fastapi"
    },
    "front": {
      "root": "front",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "front"
      }
    }
  ]
}